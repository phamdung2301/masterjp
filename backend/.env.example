# ============================================================
# Master JP backend — file mau bien moi truong
# Copy thanh backend/.env (cung thu muc voi pom.xml) roi dien gia tri that.
# .env duoc tu dong nap khi app khoi dong (DotenvEnvironmentListener).
# Bien moi truong OS that luon co do uu tien cao hon .env.
# KHONG commit file .env that len git.
# ============================================================

# MongoDB (Atlas M0 luc dau). Co the kem ten DB trong URI,
# nhung MONGODB_DATABASE van duoc khuyen nghi de explicit.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=masterjp

# JWT — BAT BUOC, toi thieu 32 ky tu (app tu choi khoi dong neu thieu/ngan)
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Gmail SMTP (dung App Password, khong phai mat khau Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Dev-only: in ma OTP ra console thay vi gui mail. LUON false o production.
MAIL_DEV_LOG_CODE=false

# Tai khoan admin duy nhat (tao 1 lan luc khoi dong, khong reset khi restart)
ADMIN_EMAIL=admin@masterjp.local
ADMIN_PASSWORD=doi-mat-khau-manh-ngay
ADMIN_NAME=Master JP Admin

# Role/plan duoc chia se bo the cong khai (FR-035)
SHARING_ALLOWED_PLANS=PREMIUM,ADMIN

# CORS — domain frontend deploy (nhieu domain cach nhau dau phay)
FRONTEND_URL=https://master-jp-frontend.onrender.com

# Mui gio tinh streak (mac dinh gio Viet Nam)
APP_TIMEZONE=Asia/Ho_Chi_Minh
